    "Não foi possível acessar o calendário. Tente novamente.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not access the calendar. Try again."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo acceder al calendario. Inténtalo de nuevo."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible d’accéder au calendrier. Réessayez."}},"de":{"stringUnit":{"state":"translated","value":"Der Kalenderzugriff ist fehlgeschlagen. Versuchen Sie es erneut."}},"ja":{"stringUnit":{"state":"translated","value":"カレンダーにアクセスできませんでした。もう一度お試しください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法访问日历，请重试。"}}}},
