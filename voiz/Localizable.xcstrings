    "O Voiz grava você e os participantes, separa as falas e gera notas no final.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voiz records you and the participants, separates who said what, and writes notes at the end."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Voiz nimmt dich und die Teilnehmenden auf, trennt die Wortbeiträge und erstellt am Ende Notizen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Voiz os graba a ti y a los participantes, separa las intervenciones y genera notas al final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voiz vous enregistre avec les participants, sépare les prises de parole et rédige des notes à la fin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Voiz はあなたと参加者を録音し、発言者を分けて、終了時にノートを作成します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Voiz 会录制你和参与者，区分每个人的发言，并在结束时生成笔记。"
          }
        }
      }
    },
