    "A página foi criada no Notion, mas só %lld de %lld blocos subiram. Abra no Notion para conferir — exportar de novo cria outra página.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page was created in Notion, but only %lld of %lld blocks were uploaded. Open it in Notion to check — exporting again creates another page."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seite wurde in Notion erstellt, aber nur %lld von %lld Blöcken wurden hochgeladen. Öffne sie zur Überprüfung in Notion — ein erneuter Export erstellt eine weitere Seite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La página se creó en Notion, pero solo se subieron %lld de %lld bloques. Ábrela en Notion para comprobarlo; si vuelves a exportarla, se creará otra página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page a été créée dans Notion, mais seuls %lld blocs sur %lld ont été importés. Ouvrez-la dans Notion pour vérifier — un nouvel export créera une autre page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Notion にページを作成しましたが、アップロードされたのは %lld 個です（全 %lld 個）。Notion で確認してください。もう一度エクスポートすると別のページが作成されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面已在 Notion 中创建，但仅上传了 %lld 个区块，共 %lld 个。请在 Notion 中打开并检查；再次导出会创建另一个页面。"
          }
        }
      }
    },
