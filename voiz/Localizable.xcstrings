    "Permita o acesso para escolher quais contas e calendários aparecem no Voiz.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow access to choose which accounts and calendars appear in Voiz."}},"es":{"stringUnit":{"state":"translated","value":"Permite el acceso para elegir qué cuentas y calendarios aparecen en Voiz."}},"fr":{"stringUnit":{"state":"translated","value":"Autorisez l’accès pour choisir les comptes et calendriers à afficher dans Voiz."}},"de":{"stringUnit":{"state":"translated","value":"Erlauben Sie den Zugriff, um die in Voiz angezeigten Accounts und Kalender auszuwählen."}},"ja":{"stringUnit":{"state":"translated","value":"アクセスを許可すると、Voizに表示するアカウントとカレンダーを選択できます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"允许访问后，即可选择在 Voiz 中显示的账户和日历。"}}}},
    "Permitir acesso ao calendário": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow calendar access"}},"es":{"stringUnit":{"state":"translated","value":"Permitir acceso al calendario"}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser l’accès au calendrier"}},"de":{"stringUnit":{"state":"translated","value":"Kalenderzugriff erlauben"}},"ja":{"stringUnit":{"state":"translated","value":"カレンダーへのアクセスを許可"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"允许访问日历"}}}},
