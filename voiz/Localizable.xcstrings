          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推进交易所需的行动；如有提及，请注明负责人和日期。"
          }
        }
      }
    },
    "O que prometemos enviar e o que confirmar no próximo contato.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What we promised to send and what to confirm on the next contact."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was wir zu senden versprochen haben und was beim nächsten Kontakt bestätigt werden soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que prometimos enviar y lo que hay que confirmar en el próximo contacto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
