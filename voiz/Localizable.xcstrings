    "Impedimentos e dependências: quem está travado, no quê e do que precisa para destravar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Impediments and dependencies: who is blocked, on what, and what they need to get unblocked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindernisse und Abhängigkeiten: Wer wobei blockiert ist und was zum Lösen benötigt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Impedimentos y dependencias: quién está bloqueado, en qué y qué necesita para desbloquearse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obstacles et dépendances : qui est bloqué, sur quoi et ce dont cette personne a besoin pour avancer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "障害と依存関係：誰が何に行き詰まっていて、解消するために何が必要か。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻碍和依赖关系：谁被什么问题卡住，以及需要什么才能解除阻碍。"
          }
        }
      }
    },
    "Decisões fechadas na call. Se nada foi decidido, devolva a lista vazia.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decisions closed during the call. If nothing was decided, return an empty list."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Besprechung getroffene Entscheidungen. Wenn nichts entschieden wurde, gib eine leere Liste zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Decisiones cerradas en la llamada. Si no se decidió nada, devuelve una lista vacía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décisions arrêtées pendant l’appel. Si aucune décision n’a été prise, renvoyez une liste vide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話中に確定した決定事項。何も決まらなかった場合は空のリストを返してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通话中敲定的决策。如果没有做出任何决策，请返回空列表。"
          }
        }
      }
    },
    "Tarefas combinadas, com responsável e prazo somente quando ditos.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agreed tasks, with owner and due date only when explicitly stated."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereinbarte Aufgaben, mit verantwortlicher Person und Frist nur, wenn diese ausdrücklich genannt wurden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tareas acordadas, con responsable y fecha límite solo cuando se hayan indicado expresamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tâches convenues, avec le responsable et l’échéance uniquement lorsqu’ils ont été explicitement mentionnés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合意したタスク。担当者と期限は明示された場合のみ含めてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "商定的任务；只有明确提及时才注明负责人和截止日期。"
          }
        }
      }
    },
    "Assuntos adiados para fora da daily (\"levar pro 1:1\", \"discutir depois\").": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Topics deferred out of the stand-up (\"take it to the 1:1\", \"discuss later\")."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Themen, die aus dem Daily vertagt wurden („im 1:1 besprechen“, „später diskutieren“)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Temas aplazados fuera de la reunión diaria («tratarlo en el 1:1», «hablarlo después»)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sujets reportés hors du point quotidien (« en parler en 1:1 », « en discuter plus tard »)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デイリー以外に持ち越したトピック（「1:1で話す」「後で検討する」など）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从每日站会中推迟到其他场合的主题（“留到 1:1”“稍后讨论”）。"
          }
        }
      }
    },
    "1:1": {
      "extractionState": "manual",
      "localizations": {
