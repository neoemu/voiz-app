    "Quem decide, orçamento, prazo, critérios de escolha e concorrentes mencionados.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who decides, budget, timeline, selection criteria and competitors mentioned."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entscheidungstragende Personen, Budget, Zeitplan, Auswahlkriterien und genannte Wettbewerber."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quién decide, presupuesto, plazo, criterios de selección y competidores mencionados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui décide, budget, calendrier, critères de sélection et concurrents mentionnés."
          }
        },
        "ja": {
          "stringUnit": {
