            "state": "translated",
            "value": "Salary expectations, availability, work model and location — only if stated."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehaltsvorstellung, Verfügbarkeit, Arbeitsmodell und Standort — nur, sofern genannt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Expectativas salariales, disponibilidad, modalidad de trabajo y ubicación, solo si se mencionaron."
          }
        },
        "fr": {
