    "Transcrição contínua com Apple SpeechAnalyzer, com resumo automático ao encerrar.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Continuous transcription with Apple SpeechAnalyzer, with an automatic summary when you finish."}}, "es": {"stringUnit": {"state": "translated", "value": "Transcripción continua con Apple SpeechAnalyzer y resumen automático al terminar."}}, "fr": {"stringUnit": {"state": "translated", "value": "Transcription continue avec Apple SpeechAnalyzer et résumé automatique à la fin."}}, "de": {"stringUnit": {"state": "translated", "value": "Kontinuierliche Transkription mit Apple SpeechAnalyzer und automatischer Zusammenfassung am Ende."}}, "ja": {"stringUnit": {"state": "translated", "value": "Apple SpeechAnalyzerによる連続文字起こしと、終了時の自動要約。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "使用 Apple SpeechAnalyzer 连续转录，并在结束时自动生成摘要。"}}}},
    "Ao vivo": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Live"}}, "de": {"stringUnit": {"state": "translated", "value": "Live"}}, "es": {"stringUnit": {"state": "translated", "value": "En directo"}}, "fr": {"stringUnit": {"state": "translated", "value": "En direct"}}, "ja": {"stringUnit": {"state": "translated", "value": "ライブ"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "实时"}}}},
    "Apple SpeechAnalyzer do sistema, otimizado para transcrição contínua e usado automaticamente.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The system Apple SpeechAnalyzer, optimized for continuous transcription and used automatically."}}, "de": {"stringUnit": {"state": "translated", "value": "Apple SpeechAnalyzer des Systems, für kontinuierliche Transkription optimiert und automatisch verwendet."}}, "es": {"stringUnit": {"state": "translated", "value": "Apple SpeechAnalyzer del sistema, optimizado para la transcripción continua y usado automáticamente."}}, "fr": {"stringUnit": {"state": "translated", "value": "Apple SpeechAnalyzer du système, optimisé pour la transcription continue et utilisé automatiquement."}}, "ja": {"stringUnit": {"state": "translated", "value": "システムの Apple SpeechAnalyzer を連続文字起こし用に最適化し、自動的に使用します。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "系统的 Apple SpeechAnalyzer 已针对连续转录优化，并会自动使用。"}}}},
    "Engine ao vivo": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Live engine"}}, "de": {"stringUnit": {"state": "translated", "value": "Live-Engine"}}, "es": {"stringUnit": {"state": "translated", "value": "Motor en directo"}}, "fr": {"stringUnit": {"state": "translated", "value": "Moteur en direct"}}, "ja": {"stringUnit": {"state": "translated", "value": "ライブエンジン"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "实时引擎"}}}},
    "Prévia opcional do modo Qualidade. Pode aumentar o uso de CPU e bateria; não altera o transcript final.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Optional preview in Quality mode. It can increase CPU and battery use and does not affect the final transcript."}}, "de": {"stringUnit": {"state": "translated", "value": "Optionale Vorschau im Qualitätsmodus. Sie kann die CPU- und Akkunutzung erhöhen und beeinflusst das endgültige Transkript nicht."}}, "es": {"stringUnit": {"state": "translated", "value": "Vista previa opcional del modo Calidad. Puede aumentar el uso de CPU y batería y no afecta a la transcripción final."}}, "fr": {"stringUnit": {"state": "translated", "value": "Aperçu facultatif du mode Qualité. Il peut augmenter l’utilisation du processeur et de la batterie et n’affecte pas la transcription finale."}}, "ja": {"stringUnit": {"state": "translated", "value": "高品質モードのオプションプレビューです。CPU とバッテリーの使用量が増える場合がありますが、最終的な文字起こしには影響しません。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "高质量模式的可选预览。它可能会增加 CPU 和电量使用，但不会影响最终转录。"}}}},
    "Assistência durante a gravação": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Assistance during recording"}}, "es": {"stringUnit": {"state": "translated", "value": "Asistencia durante la grabación"}}, "fr": {"stringUnit": {"state": "translated", "value": "Assistance pendant l’enregistrement"}}, "de": {"stringUnit": {"state": "translated", "value": "Assistenz während der Aufnahme"}}, "ja": {"stringUnit": {"state": "translated", "value": "録音中のアシスト"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "录音期间的辅助"}}}},
    "Você escolhe o que acompanhar": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "You choose what to follow"}}, "es": {"stringUnit": {"state": "translated", "value": "Tú eliges qué seguir"}}, "fr": {"stringUnit": {"state": "translated", "value": "Vous choisissez quoi suivre"}}, "de": {"stringUnit": {"state": "translated", "value": "Sie entscheiden, was Sie verfolgen"}}, "ja": {"stringUnit": {"state": "translated", "value": "フォローする項目を選べます"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "由您选择关注哪些事项"}}}},
    "Ver reuniões": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "View meetings"}}, "es": {"stringUnit": {"state": "translated", "value": "Ver reuniones"}}, "fr": {"stringUnit": {"state": "translated", "value": "Voir les réunions"}}, "de": {"stringUnit": {"state": "translated", "value": "Besprechungen ansehen"}}, "ja": {"stringUnit": {"state": "translated", "value": "会議を見る"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "查看会议"}}}},
    "Acompanhar": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Follow"}}, "es": {"stringUnit": {"state": "translated", "value": "Seguir"}}, "fr": {"stringUnit": {"state": "translated", "value": "Suivre"}}, "de": {"stringUnit": {"state": "translated", "value": "Verfolgen"}}, "ja": {"stringUnit": {"state": "translated", "value": "フォロー"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "关注"}}}},
    "Deixar de acompanhar": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Stop following"}}, "es": {"stringUnit": {"state": "translated", "value": "Dejar de seguir"}}, "fr": {"stringUnit": {"state": "translated", "value": "Ne plus suivre"}}, "de": {"stringUnit": {"state": "translated", "value": "Nicht mehr verfolgen"}}, "ja": {"stringUnit": {"state": "translated", "value": "フォローを解除"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "取消关注"}}}},
    "%lld em acompanhamento": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "%lld followed actions"}}, "es": {"stringUnit": {"state": "translated", "value": "%lld en seguimiento"}}, "fr": {"stringUnit": {"state": "translated", "value": "%lld actions suivies"}}, "de": {"stringUnit": {"state": "translated", "value": "%lld verfolgte Aktionen"}}, "ja": {"stringUnit": {"state": "translated", "value": "フォロー中 %lld 件"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在关注 %lld 项"}}}},
    "Acompanhamento": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Following"}}, "es": {"stringUnit": {"state": "translated", "value": "Seguimiento"}}, "fr": {"stringUnit": {"state": "translated", "value": "Suivi"}}, "de": {"stringUnit": {"state": "translated", "value": "Verfolgte Aktionen"}}, "ja": {"stringUnit": {"state": "translated", "value": "フォロー中"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "关注事项"}}}},
    "Ações em acompanhamento": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Followed actions"}}, "es": {"stringUnit": {"state": "translated", "value": "Acciones en seguimiento"}}, "fr": {"stringUnit": {"state": "translated", "value": "Actions suivies"}}, "de": {"stringUnit": {"state": "translated", "value": "Verfolgte Aktionen"}}, "ja": {"stringUnit": {"state": "translated", "value": "フォロー中のアクション"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "关注的事项"}}}},
    "Listar tarefas em acompanhamento": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "List followed tasks"}}, "es": {"stringUnit": {"state": "translated", "value": "Listar tareas en seguimiento"}}, "fr": {"stringUnit": {"state": "translated", "value": "Lister les tâches suivies"}}, "de": {"stringUnit": {"state": "translated", "value": "Verfolgte Aufgaben auflisten"}}, "ja": {"stringUnit": {"state": "translated", "value": "フォロー中のタスクを表示"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "列出关注的任务"}}}},
    "Preparando reunião…": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Preparing meeting…"}}, "es": {"stringUnit": {"state": "translated", "value": "Preparando reunión…"}}, "de": {"stringUnit": {"state": "translated", "value": "Besprechung wird vorbereitet…"}}, "fr": {"stringUnit": {"state": "translated", "value": "Préparation de la réunion…"}}, "ja": {"stringUnit": {"state": "translated", "value": "会議を準備中…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在准备会议…"}}}},
    "Voltar à reunião em andamento": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Return to the ongoing meeting"}}, "es": {"stringUnit": {"state": "translated", "value": "Volver a la reunión en curso"}}, "de": {"stringUnit": {"state": "translated", "value": "Zur laufenden Besprechung zurückkehren"}}, "fr": {"stringUnit": {"state": "translated", "value": "Revenir à la réunion en cours"}}, "ja": {"stringUnit": {"state": "translated", "value": "進行中の会議に戻る"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "返回正在进行的会议"}}}},
    "Liste decisões confirmadas, separando propostas ainda abertas. Cite as fontes disponíveis.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "List confirmed decisions, separating proposals still under discussion. Cite available sources."}}, "es": {"stringUnit": {"state": "translated", "value": "Enumera las decisiones confirmadas y separa las propuestas abiertas. Cita las fuentes disponibles."}}, "fr": {"stringUnit": {"state": "translated", "value": "Listez les décisions confirmées en distinguant les propositions encore ouvertes. Citez les sources disponibles."}}, "de": {"stringUnit": {"state": "translated", "value": "Listen Sie bestätigte Entscheidungen getrennt von offenen Vorschlägen auf. Zitieren Sie verfügbare Quellen."}}, "ja": {"stringUnit": {"state": "translated", "value": "確定した決定事項を、検討中の提案と分けて列挙してください。利用可能な情報源を引用してください。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "列出已确认的决策，并与仍在讨论的提案区分开。引用可用来源。"}}}},
    "Liste riscos e bloqueios mencionados, com impacto e próximo passo quando houver evidência.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "List the risks and blockers mentioned, including impact and next steps when supported by evidence."}}, "es": {"stringUnit": {"state": "translated", "value": "Enumera los riesgos y bloqueos mencionados, con impacto y próximos pasos cuando haya evidencia."}}, "fr": {"stringUnit": {"state": "translated", "value": "Listez les risques et blocages mentionnés, avec leur impact et les prochaines étapes lorsque les sources le permettent."}}, "de": {"stringUnit": {"state": "translated", "value": "Listen Sie erwähnte Risiken und Hindernisse auf, einschließlich Auswirkungen und nächster Schritte, soweit belegt."}}, "ja": {"stringUnit": {"state": "translated", "value": "言及されたリスクと障害を列挙し、根拠がある場合は影響と次のステップも示してください。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "列出提到的风险和阻碍，并在有依据时说明影响和下一步行动。"}}}},
    "Prepare um rascunho curto de follow-up com decisões, responsáveis e próximos passos. Não envie nada.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Draft a short follow-up with decisions, owners and next steps. Do not send anything."}}, "es": {"stringUnit": {"state": "translated", "value": "Prepara un borrador breve de seguimiento con decisiones, responsables y próximos pasos. No envíes nada."}}, "fr": {"stringUnit": {"state": "translated", "value": "Rédigez un bref brouillon de suivi avec décisions, responsables et prochaines étapes. N’envoyez rien."}}, "de": {"stringUnit": {"state": "translated", "value": "Entwerfen Sie eine kurze Nachbereitung mit Entscheidungen, Verantwortlichen und nächsten Schritten. Senden Sie nichts."}}, "ja": {"stringUnit": {"state": "translated", "value": "決定事項、担当者、次のステップを含む短いフォローアップの下書きを作成してください。送信はしないでください。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "起草一份简短的跟进内容，包含决策、负责人和下一步行动。不要发送任何内容。"}}}},
    "Acompanhe as pendências de todas as reuniões.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Track action items from all your meetings."}}, "es": {"stringUnit": {"state": "translated", "value": "Sigue los pendientes de todas tus reuniones."}}, "fr": {"stringUnit": {"state": "translated", "value": "Suivez les actions de toutes vos réunions."}}, "de": {"stringUnit": {"state": "translated", "value": "Verfolgen Sie offene Aufgaben aus allen Besprechungen."}}, "ja": {"stringUnit": {"state": "translated", "value": "すべての会議の未完了タスクを確認できます。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "跟踪所有会议的待办事项。"}}}},
    "Responsável": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Owner"}}, "es": {"stringUnit": {"state": "translated", "value": "Responsable"}}, "fr": {"stringUnit": {"state": "translated", "value": "Responsable"}}, "de": {"stringUnit": {"state": "translated", "value": "Verantwortlich"}}, "ja": {"stringUnit": {"state": "translated", "value": "担当者"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "负责人"}}}},
    "Todas": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "All"}}, "es": {"stringUnit": {"state": "translated", "value": "Todas"}}, "fr": {"stringUnit": {"state": "translated", "value": "Toutes"}}, "de": {"stringUnit": {"state": "translated", "value": "Alle"}}, "ja": {"stringUnit": {"state": "translated", "value": "すべて"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "全部"}}}},
    "Concluídas": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Completed"}}, "es": {"stringUnit": {"state": "translated", "value": "Completadas"}}, "fr": {"stringUnit": {"state": "translated", "value": "Terminées"}}, "de": {"stringUnit": {"state": "translated", "value": "Erledigt"}}, "ja": {"stringUnit": {"state": "translated", "value": "完了"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已完成"}}}},
    "Nenhuma tarefa": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "No tasks"}}, "es": {"stringUnit": {"state": "translated", "value": "No hay tareas"}}, "fr": {"stringUnit": {"state": "translated", "value": "Aucune tâche"}}, "de": {"stringUnit": {"state": "translated", "value": "Keine Aufgaben"}}, "ja": {"stringUnit": {"state": "translated", "value": "タスクはありません"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "暂无任务"}}}},
    "As ações extraídas das reuniões aparecem aqui. Ajuste os filtros para ver outras tarefas.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Action items from meetings appear here. Adjust the filters to see other tasks."}}, "es": {"stringUnit": {"state": "translated", "value": "Aquí aparecen las acciones de las reuniones. Ajusta los filtros para ver otras tareas."}}, "fr": {"stringUnit": {"state": "translated", "value": "Les actions des réunions apparaissent ici. Modifiez les filtres pour voir d’autres tâches."}}, "de": {"stringUnit": {"state": "translated", "value": "Hier erscheinen Aufgaben aus Besprechungen. Passen Sie die Filter an, um weitere Aufgaben anzuzeigen."}}, "ja": {"stringUnit": {"state": "translated", "value": "会議から抽出されたタスクがここに表示されます。フィルターを変更すると他のタスクも確認できます。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "会议中提取的任务会显示在此处。调整筛选条件以查看其他任务。"}}}},
    "Editar tarefa": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Edit task"}}, "es": {"stringUnit": {"state": "translated", "value": "Editar tarea"}}, "fr": {"stringUnit": {"state": "translated", "value": "Modifier la tâche"}}, "de": {"stringUnit": {"state": "translated", "value": "Aufgabe bearbeiten"}}, "ja": {"stringUnit": {"state": "translated", "value": "タスクを編集"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "编辑任务"}}}},
    "Tarefa": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Task"}}, "es": {"stringUnit": {"state": "translated", "value": "Tarea"}}, "fr": {"stringUnit": {"state": "translated", "value": "Tâche"}}, "de": {"stringUnit": {"state": "translated", "value": "Aufgabe"}}, "ja": {"stringUnit": {"state": "translated", "value": "タスク"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "任务"}}}},
    "Prazo": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Due date"}}, "es": {"stringUnit": {"state": "translated", "value": "Fecha límite"}}, "fr": {"stringUnit": {"state": "translated", "value": "Échéance"}}, "de": {"stringUnit": {"state": "translated", "value": "Frist"}}, "ja": {"stringUnit": {"state": "translated", "value": "期限"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "截止日期"}}}},
    "%lld pendências": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "%lld open tasks"}}, "es": {"stringUnit": {"state": "translated", "value": "%lld tareas pendientes"}}, "fr": {"stringUnit": {"state": "translated", "value": "%lld tâches en cours"}}, "de": {"stringUnit": {"state": "translated", "value": "%lld offene Aufgaben"}}, "ja": {"stringUnit": {"state": "translated", "value": "未完了タスク %lld 件"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "%lld 项待办任务"}}}},
    "Preparar": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Prepare"}}, "es": {"stringUnit": {"state": "translated", "value": "Preparar"}}, "fr": {"stringUnit": {"state": "translated", "value": "Préparer"}}, "de": {"stringUnit": {"state": "translated", "value": "Vorbereiten"}}, "ja": {"stringUnit": {"state": "translated", "value": "準備"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "准备"}}}},
    "Nenhuma reunião próxima na agenda.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "No upcoming meetings on your calendar."}}, "es": {"stringUnit": {"state": "translated", "value": "No hay próximas reuniones en tu calendario."}}, "fr": {"stringUnit": {"state": "translated", "value": "Aucune réunion à venir dans votre calendrier."}}, "de": {"stringUnit": {"state": "translated", "value": "Keine anstehenden Besprechungen im Kalender."}}, "ja": {"stringUnit": {"state": "translated", "value": "カレンダーに今後の会議はありません。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "日历中暂无即将举行的会议。"}}}},
    "Ative o calendário em Reuniões para preparar suas próximas conversas.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Enable calendar access in Meetings to prepare for upcoming conversations."}}, "es": {"stringUnit": {"state": "translated", "value": "Activa el calendario en Reuniones para preparar tus próximas conversaciones."}}, "fr": {"stringUnit": {"state": "translated", "value": "Activez le calendrier dans Réunions pour préparer vos prochains échanges."}}, "de": {"stringUnit": {"state": "translated", "value": "Aktivieren Sie den Kalender unter Besprechungen, um Gespräche vorzubereiten."}}, "ja": {"stringUnit": {"state": "translated", "value": "「会議」でカレンダーを有効にすると、次の会話を準備できます。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "在“会议”中启用日历，以准备接下来的交流。"}}}},
    "Preparar reunião": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Prepare for meeting"}}, "es": {"stringUnit": {"state": "translated", "value": "Preparar reunión"}}, "fr": {"stringUnit": {"state": "translated", "value": "Préparer la réunion"}}, "de": {"stringUnit": {"state": "translated", "value": "Besprechung vorbereiten"}}, "ja": {"stringUnit": {"state": "translated", "value": "会議を準備"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "准备会议"}}}},
    "Reuniões de contexto": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Context meetings"}}, "es": {"stringUnit": {"state": "translated", "value": "Reuniones de contexto"}}, "fr": {"stringUnit": {"state": "translated", "value": "Réunions de contexte"}}, "de": {"stringUnit": {"state": "translated", "value": "Besprechungen als Kontext"}}, "ja": {"stringUnit": {"state": "translated", "value": "参考にする会議"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "参考会议"}}}},
    "Ao gerar, o texto das reuniões selecionadas será enviado ao provedor de IA configurado.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Generating sends the selected meetings’ text to your configured AI provider."}}, "es": {"stringUnit": {"state": "translated", "value": "Al generar, se enviará el texto de las reuniones seleccionadas al proveedor de IA configurado."}}, "fr": {"stringUnit": {"state": "translated", "value": "La génération envoie le texte des réunions sélectionnées au fournisseur d’IA configuré."}}, "de": {"stringUnit": {"state": "translated", "value": "Bei der Erstellung wird der Text der ausgewählten Besprechungen an Ihren KI-Anbieter gesendet."}}, "ja": {"stringUnit": {"state": "translated", "value": "生成時に、選択した会議のテキストが設定済みのAIプロバイダーに送信されます。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "生成时，所选会议的文本将发送给已配置的 AI 提供商。"}}}},
    "Gerar preparação": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Generate briefing"}}, "es": {"stringUnit": {"state": "translated", "value": "Generar preparación"}}, "fr": {"stringUnit": {"state": "translated", "value": "Générer la préparation"}}, "de": {"stringUnit": {"state": "translated", "value": "Vorbereitung erstellen"}}, "ja": {"stringUnit": {"state": "translated", "value": "準備メモを生成"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "生成会前简报"}}}},
    "Atualizar preparação": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Update briefing"}}, "es": {"stringUnit": {"state": "translated", "value": "Actualizar preparación"}}, "fr": {"stringUnit": {"state": "translated", "value": "Actualiser la préparation"}}, "de": {"stringUnit": {"state": "translated", "value": "Vorbereitung aktualisieren"}}, "ja": {"stringUnit": {"state": "translated", "value": "準備メモを更新"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "更新会前简报"}}}},
    "Entre na conversa com contexto": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Join the conversation prepared"}}, "es": {"stringUnit": {"state": "translated", "value": "Llega a la conversación con contexto"}}, "fr": {"stringUnit": {"state": "translated", "value": "Abordez la conversation avec le contexte"}}, "de": {"stringUnit": {"state": "translated", "value": "Gut vorbereitet ins Gespräch"}}, "ja": {"stringUnit": {"state": "translated", "value": "背景を把握して会話に参加"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "带着背景信息开始交流"}}}},
    "Selecione até oito reuniões para recuperar decisões, pendências e perguntas úteis.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Select up to eight meetings to review decisions, open tasks and useful questions."}}, "es": {"stringUnit": {"state": "translated", "value": "Selecciona hasta ocho reuniones para revisar decisiones, pendientes y preguntas útiles."}}, "fr": {"stringUnit": {"state": "translated", "value": "Sélectionnez jusqu’à huit réunions pour retrouver décisions, tâches et questions utiles."}}, "de": {"stringUnit": {"state": "translated", "value": "Wählen Sie bis zu acht Besprechungen für Entscheidungen, offene Aufgaben und nützliche Fragen."}}, "ja": {"stringUnit": {"state": "translated", "value": "最大8件の会議を選択して、決定事項、未完了タスク、役立つ質問を確認できます。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "最多选择八场会议，回顾决策、待办事项和有用的问题。"}}}},
    "Buscar reuniões…": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Search meetings…"}}, "es": {"stringUnit": {"state": "translated", "value": "Buscar reuniones…"}}, "fr": {"stringUnit": {"state": "translated", "value": "Rechercher des réunions…"}}, "de": {"stringUnit": {"state": "translated", "value": "Besprechungen suchen…"}}, "ja": {"stringUnit": {"state": "translated", "value": "会議を検索…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "搜索会议…"}}}},
    "Pasta": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Folder"}}, "es": {"stringUnit": {"state": "translated", "value": "Carpeta"}}, "fr": {"stringUnit": {"state": "translated", "value": "Dossier"}}, "de": {"stringUnit": {"state": "translated", "value": "Ordner"}}, "ja": {"stringUnit": {"state": "translated", "value": "フォルダ"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "文件夹"}}}},
    "%lld/8 selecionadas": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "%lld/8 selected"}}, "es": {"stringUnit": {"state": "translated", "value": "%lld/8 seleccionadas"}}, "fr": {"stringUnit": {"state": "translated", "value": "%lld/8 sélectionnées"}}, "de": {"stringUnit": {"state": "translated", "value": "%lld/8 ausgewählt"}}, "ja": {"stringUnit": {"state": "translated", "value": "%lld/8 件選択済み"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已选择 %lld/8 场"}}}},
    "Nenhuma reunião encontrada.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "No meetings found."}}, "es": {"stringUnit": {"state": "translated", "value": "No se encontraron reuniones."}}, "fr": {"stringUnit": {"state": "translated", "value": "Aucune réunion trouvée."}}, "de": {"stringUnit": {"state": "translated", "value": "Keine Besprechungen gefunden."}}, "ja": {"stringUnit": {"state": "translated", "value": "会議が見つかりません。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "未找到会议。"}}}},
    "Reunião de origem": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Source meeting"}}, "es": {"stringUnit": {"state": "translated", "value": "Reunión de origen"}}, "fr": {"stringUnit": {"state": "translated", "value": "Réunion source"}}, "de": {"stringUnit": {"state": "translated", "value": "Ursprüngliche Besprechung"}}, "ja": {"stringUnit": {"state": "translated", "value": "元の会議"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "来源会议"}}}},
    "Usar estas notas no resumo": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Include these notes in the summary"}}, "es": {"stringUnit": {"state": "translated", "value": "Usar estas notas en el resumen"}}, "fr": {"stringUnit": {"state": "translated", "value": "Inclure ces notes dans le résumé"}}, "de": {"stringUnit": {"state": "translated", "value": "Diese Notizen im Überblick verwenden"}}, "ja": {"stringUnit": {"state": "translated", "value": "これらのメモを要約に含める"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "在摘要中使用这些笔记"}}}},
    "Comandos": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Commands"}}, "es": {"stringUnit": {"state": "translated", "value": "Comandos"}}, "fr": {"stringUnit": {"state": "translated", "value": "Commandes"}}, "de": {"stringUnit": {"state": "translated", "value": "Befehle"}}, "ja": {"stringUnit": {"state": "translated", "value": "コマンド"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "命令"}}}},
    "Editar comandos…": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Edit commands…"}}, "es": {"stringUnit": {"state": "translated", "value": "Editar comandos…"}}, "fr": {"stringUnit": {"state": "translated", "value": "Modifier les commandes…"}}, "de": {"stringUnit": {"state": "translated", "value": "Befehle bearbeiten…"}}, "ja": {"stringUnit": {"state": "translated", "value": "コマンドを編集…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "编辑命令…"}}}},
    "Comandos — ou digite / no campo": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Commands — or type / in the field"}}, "es": {"stringUnit": {"state": "translated", "value": "Comandos — o escribe / en el campo"}}, "fr": {"stringUnit": {"state": "translated", "value": "Commandes — ou tapez / dans le champ"}}, "de": {"stringUnit": {"state": "translated", "value": "Befehle — oder / ins Feld tippen"}}, "ja": {"stringUnit": {"state": "translated", "value": "コマンド — または入力欄に / を入力"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "命令 — 或在输入框中输入 /"}}}},
    "O que ficou pendente esta semana?": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "What is still pending this week?"}}, "es": {"stringUnit": {"state": "translated", "value": "¿Qué quedó pendiente esta semana?"}}, "fr": {"stringUnit": {"state": "translated", "value": "Qu’est-ce qui reste en suspens cette semaine ?"}}, "de": {"stringUnit": {"state": "translated", "value": "Was ist diese Woche noch offen?"}}, "ja": {"stringUnit": {"state": "translated", "value": "今週、何が未完了ですか？"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "这周还有什么未完成？"}}}},
    "Quais decisões saíram das últimas reuniões?": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "What decisions came out of the latest meetings?"}}, "es": {"stringUnit": {"state": "translated", "value": "¿Qué decisiones salieron de las últimas reuniones?"}}, "fr": {"stringUnit": {"state": "translated", "value": "Quelles décisions sont sorties des dernières réunions ?"}}, "de": {"stringUnit": {"state": "translated", "value": "Welche Entscheidungen kamen aus den letzten Meetings?"}}, "ja": {"stringUnit": {"state": "translated", "value": "最近の会議でどんな決定がありましたか？"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "最近几次会议做出了哪些决定？"}}}},
    "O que preciso para o próximo follow-up?": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "What do I need for the next follow-up?"}}, "es": {"stringUnit": {"state": "translated", "value": "¿Qué necesito para el próximo follow-up?"}}, "fr": {"stringUnit": {"state": "translated", "value": "De quoi ai-je besoin pour le prochain follow-up ?"}}, "de": {"stringUnit": {"state": "translated", "value": "Was brauche ich für das nächste Follow-up?"}}, "ja": {"stringUnit": {"state": "translated", "value": "次のフォローアップに何が必要ですか？"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "下一次跟进我需要准备什么？"}}}},
    "Nenhum comando corresponde a “/%@”": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "No command matches “/%@”"}}, "es": {"stringUnit": {"state": "translated", "value": "Ningún comando coincide con “/%@”"}}, "fr": {"stringUnit": {"state": "translated", "value": "Aucune commande ne correspond à « /%@ »"}}, "de": {"stringUnit": {"state": "translated", "value": "Kein Befehl passt zu „/%@“"}}, "ja": {"stringUnit": {"state": "translated", "value": "「/%@」に一致するコマンドはありません"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "没有与“/%@”匹配的命令"}}}},
    "Enter envia o texto como está. Crie o seu em “Novo comando”.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Enter sends the text as is. Create your own with “New command”."}}, "es": {"stringUnit": {"state": "translated", "value": "Enter envía el texto tal cual. Crea el tuyo en “Nuevo comando”."}}, "fr": {"stringUnit": {"state": "translated", "value": "Entrée envoie le texte tel quel. Créez le vôtre avec « Nouvelle commande »."}}, "de": {"stringUnit": {"state": "translated", "value": "Enter sendet den Text unverändert. Eigene unter „Neuer Befehl“ anlegen."}}, "ja": {"stringUnit": {"state": "translated", "value": "Enter でそのまま送信します。「新しいコマンド」で自分のコマンドを作成できます。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "按 Enter 原样发送。可通过“新建命令”创建自己的命令。"}}}},
    "Escolher": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Choose"}}, "es": {"stringUnit": {"state": "translated", "value": "Elegir"}}, "fr": {"stringUnit": {"state": "translated", "value": "Choisir"}}, "de": {"stringUnit": {"state": "translated", "value": "Auswählen"}}, "ja": {"stringUnit": {"state": "translated", "value": "選択"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "选择"}}}},
    "Use /comando e complete com o que quiser": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Use /command and add anything you want"}}, "es": {"stringUnit": {"state": "translated", "value": "Usa /comando y completa con lo que quieras"}}, "fr": {"stringUnit": {"state": "translated", "value": "Utilisez /commande et complétez comme vous voulez"}}, "de": {"stringUnit": {"state": "translated", "value": "/befehl verwenden und beliebig ergänzen"}}, "ja": {"stringUnit": {"state": "translated", "value": "/コマンド に続けて自由に入力できます"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "使用 /命令 并补充任意内容"}}}},
    "Use /comando no chat ou durante uma reunião. Comandos usam letras minúsculas, números, - ou _.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Use /command in chat or during a meeting. Commands use lowercase letters, numbers, - or _."}}, "es": {"stringUnit": {"state": "translated", "value": "Usa /comando en el chat o en una reunión. Usa letras minúsculas, números, - o _."}}, "fr": {"stringUnit": {"state": "translated", "value": "Utilisez /commande dans le chat ou en réunion. Les commandes utilisent des minuscules, chiffres, - ou _."}}, "de": {"stringUnit": {"state": "translated", "value": "Verwenden Sie /befehl im Chat oder in Besprechungen. Erlaubt sind Kleinbuchstaben, Zahlen, - und _."}}, "ja": {"stringUnit": {"state": "translated", "value": "チャットや会議中に /コマンド を使用できます。コマンドには英小文字、数字、-、_ を使います。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "在聊天或会议中使用 /命令。命令可包含小写英文字母、数字、- 或 _。"}}}},
    "Comando": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Command"}}, "es": {"stringUnit": {"state": "translated", "value": "Comando"}}, "fr": {"stringUnit": {"state": "translated", "value": "Commande"}}, "de": {"stringUnit": {"state": "translated", "value": "Befehl"}}, "ja": {"stringUnit": {"state": "translated", "value": "コマンド"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "命令"}}}},
    "Remover comando": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Remove command"}}, "es": {"stringUnit": {"state": "translated", "value": "Eliminar comando"}}, "fr": {"stringUnit": {"state": "translated", "value": "Supprimer la commande"}}, "de": {"stringUnit": {"state": "translated", "value": "Befehl entfernen"}}, "ja": {"stringUnit": {"state": "translated", "value": "コマンドを削除"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "移除命令"}}}},
    "Preencha nome e instrução e use comandos válidos e únicos.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Enter a name and instructions, and use valid, unique commands."}}, "es": {"stringUnit": {"state": "translated", "value": "Completa el nombre y las instrucciones y usa comandos válidos y únicos."}}, "fr": {"stringUnit": {"state": "translated", "value": "Renseignez le nom et les instructions et utilisez des commandes valides et uniques."}}, "de": {"stringUnit": {"state": "translated", "value": "Geben Sie Namen und Anweisungen ein und verwenden Sie gültige, eindeutige Befehle."}}, "ja": {"stringUnit": {"state": "translated", "value": "名前と指示を入力し、有効で重複しないコマンドを使用してください。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请填写名称和指令，并使用有效且唯一的命令。"}}}},
    "Novo comando": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "New command"}}, "es": {"stringUnit": {"state": "translated", "value": "Nuevo comando"}}, "fr": {"stringUnit": {"state": "translated", "value": "Nouvelle commande"}}, "de": {"stringUnit": {"state": "translated", "value": "Neuer Befehl"}}, "ja": {"stringUnit": {"state": "translated", "value": "新しいコマンド"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "新建命令"}}}},
    "Ex.: Preparar follow-up": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "E.g. Prepare follow-up"}}, "es": {"stringUnit": {"state": "translated", "value": "Ej.: Preparar seguimiento"}}, "fr": {"stringUnit": {"state": "translated", "value": "Ex. : Préparer le suivi"}}, "de": {"stringUnit": {"state": "translated", "value": "Z. B. Follow-up vorbereiten"}}, "ja": {"stringUnit": {"state": "translated", "value": "例：フォローアップを準備"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "例如：准备跟进"}}}},
    "Instrução": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Instruction"}}, "es": {"stringUnit": {"state": "translated", "value": "Instrucción"}}, "fr": {"stringUnit": {"state": "translated", "value": "Instruction"}}, "de": {"stringUnit": {"state": "translated", "value": "Anweisung"}}, "ja": {"stringUnit": {"state": "translated", "value": "指示"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "指令"}}}},
    "Ex.: Liste as decisões confirmadas, separando propostas ainda abertas.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "E.g. List the confirmed decisions, separating proposals still open."}}, "es": {"stringUnit": {"state": "translated", "value": "Ej.: Enumera las decisiones confirmadas, separando las propuestas aún abiertas."}}, "fr": {"stringUnit": {"state": "translated", "value": "Ex. : Listez les décisions confirmées en séparant les propositions encore ouvertes."}}, "de": {"stringUnit": {"state": "translated", "value": "Z. B. Liste die bestätigten Entscheidungen auf, getrennt von noch offenen Vorschlägen."}}, "ja": {"stringUnit": {"state": "translated", "value": "例：確定した決定事項を、まだ未決の提案と分けて列挙してください。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "例如：列出已确认的决定，并将仍未决的提案分开。"}}}},
    "O que a IA deve fazer ao receber este comando. O texto digitado depois do comando entra como complemento.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "What the AI should do when it gets this command. Text typed after the command is added as a complement."}}, "es": {"stringUnit": {"state": "translated", "value": "Qué debe hacer la IA al recibir este comando. El texto escrito después del comando se añade como complemento."}}, "fr": {"stringUnit": {"state": "translated", "value": "Ce que l’IA doit faire à la réception de cette commande. Le texte saisi après la commande est ajouté en complément."}}, "de": {"stringUnit": {"state": "translated", "value": "Was die KI bei diesem Befehl tun soll. Nach dem Befehl eingegebener Text wird als Ergänzung angehängt."}}, "ja": {"stringUnit": {"state": "translated", "value": "このコマンドを受け取ったときに AI が行うこと。コマンドの後に入力したテキストは補足として追加されます。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "AI 收到此命令时应做的事。命令后输入的文本将作为补充附加。"}}}},
    "Use só letras minúsculas, números, - ou _.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Use only lowercase letters, numbers, - or _."}}, "es": {"stringUnit": {"state": "translated", "value": "Usa solo letras minúsculas, números, - o _."}}, "fr": {"stringUnit": {"state": "translated", "value": "Utilisez uniquement des minuscules, des chiffres, - ou _."}}, "de": {"stringUnit": {"state": "translated", "value": "Nur Kleinbuchstaben, Zahlen, - oder _ verwenden."}}, "ja": {"stringUnit": {"state": "translated", "value": "小文字、数字、- または _ のみ使用できます。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "只能使用小写字母、数字、- 或 _。"}}}},
    "Já existe um comando com esse atalho.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "A command with this shortcut already exists."}}, "es": {"stringUnit": {"state": "translated", "value": "Ya existe un comando con ese atajo."}}, "fr": {"stringUnit": {"state": "translated", "value": "Une commande avec ce raccourci existe déjà."}}, "de": {"stringUnit": {"state": "translated", "value": "Ein Befehl mit diesem Kürzel existiert bereits."}}, "ja": {"stringUnit": {"state": "translated", "value": "このショートカットのコマンドはすでに存在します。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已存在使用此快捷方式的命令。"}}}},
    "Nenhum comando": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "No commands"}}, "es": {"stringUnit": {"state": "translated", "value": "Ningún comando"}}, "fr": {"stringUnit": {"state": "translated", "value": "Aucune commande"}}, "de": {"stringUnit": {"state": "translated", "value": "Keine Befehle"}}, "ja": {"stringUnit": {"state": "translated", "value": "コマンドがありません"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "没有命令"}}}},
    "Reabrir": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Reopen"}}, "es": {"stringUnit": {"state": "translated", "value": "Reabrir"}}, "fr": {"stringUnit": {"state": "translated", "value": "Rouvrir"}}, "de": {"stringUnit": {"state": "translated", "value": "Wieder öffnen"}}, "ja": {"stringUnit": {"state": "translated", "value": "再開"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "重新打开"}}}},
    "Definir prazo": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Set a due date"}}, "es": {"stringUnit": {"state": "translated", "value": "Definir plazo"}}, "fr": {"stringUnit": {"state": "translated", "value": "Définir une échéance"}}, "de": {"stringUnit": {"state": "translated", "value": "Frist festlegen"}}, "ja": {"stringUnit": {"state": "translated", "value": "期限を設定"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "设置截止日期"}}}},
    "Dito na reunião: %@": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Said in the meeting: %@"}}, "es": {"stringUnit": {"state": "translated", "value": "Dicho en la reunión: %@"}}, "fr": {"stringUnit": {"state": "translated", "value": "Dit en réunion : %@"}}, "de": {"stringUnit": {"state": "translated", "value": "Im Meeting gesagt: %@"}}, "ja": {"stringUnit": {"state": "translated", "value": "会議での発言：%@"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "会议中提到：%@"}}}},
    "Ex.: Matheus": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "E.g. Matheus"}}, "es": {"stringUnit": {"state": "translated", "value": "Ej.: Matheus"}}, "fr": {"stringUnit": {"state": "translated", "value": "Ex. : Matheus"}}, "de": {"stringUnit": {"state": "translated", "value": "Z. B. Matheus"}}, "ja": {"stringUnit": {"state": "translated", "value": "例：Matheus"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "例如：Matheus"}}}},
    "Em acompanhamento": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Tracking"}}, "es": {"stringUnit": {"state": "translated", "value": "En seguimiento"}}, "fr": {"stringUnit": {"state": "translated", "value": "En suivi"}}, "de": {"stringUnit": {"state": "translated", "value": "Im Blick"}}, "ja": {"stringUnit": {"state": "translated", "value": "フォロー中"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "跟进中"}}}},
    "Pendências": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Open items"}}, "es": {"stringUnit": {"state": "translated", "value": "Pendientes"}}, "fr": {"stringUnit": {"state": "translated", "value": "En attente"}}, "de": {"stringUnit": {"state": "translated", "value": "Offene Punkte"}}, "ja": {"stringUnit": {"state": "translated", "value": "未完了"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "待办事项"}}}},
    "Liste as ações pendentes que estou acompanhando, agrupadas por responsável, com a reunião de origem e o prazo quando houver. Destaque o que está atrasado.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "List the open action items I am tracking, grouped by owner, with the source meeting and the due date when there is one. Highlight what is overdue."}}, "es": {"stringUnit": {"state": "translated", "value": "Enumera las acciones pendientes que estoy siguiendo, agrupadas por responsable, con la reunión de origen y el plazo cuando exista. Destaca lo que está atrasado."}}, "fr": {"stringUnit": {"state": "translated", "value": "Liste les actions en attente que je suis, regroupées par responsable, avec la réunion d’origine et l’échéance le cas échéant. Mets en évidence ce qui est en retard."}}, "de": {"stringUnit": {"state": "translated", "value": "Liste die offenen Aufgaben, die ich verfolge, nach Verantwortlichen gruppiert, mit dem Ursprungsmeeting und der Frist, falls vorhanden. Hebe Überfälliges hervor."}}, "ja": {"stringUnit": {"state": "translated", "value": "私が追跡している未完了のアクションを担当者ごとにまとめ、元の会議と期限（あれば）を添えて列挙してください。遅れているものを強調してください。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "列出我正在跟进的待办事项，按负责人分组，注明来源会议和截止日期（如有）。突出显示已逾期的项目。"}}}},
    "As alterações são salvas automaticamente.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Changes are saved automatically."}}, "es": {"stringUnit": {"state": "translated", "value": "Los cambios se guardan automáticamente."}}, "fr": {"stringUnit": {"state": "translated", "value": "Les modifications sont enregistrées automatiquement."}}, "de": {"stringUnit": {"state": "translated", "value": "Änderungen werden automatisch gespeichert."}}, "ja": {"stringUnit": {"state": "translated", "value": "変更は自動的に保存されます。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "更改会自动保存。"}}}},
    "Crie um comando para usar com / no chat.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Create a command to use with / in the chat."}}, "es": {"stringUnit": {"state": "translated", "value": "Crea un comando para usarlo con / en el chat."}}, "fr": {"stringUnit": {"state": "translated", "value": "Créez une commande à utiliser avec / dans le chat."}}, "de": {"stringUnit": {"state": "translated", "value": "Erstelle einen Befehl, den du im Chat mit / verwendest."}}, "ja": {"stringUnit": {"state": "translated", "value": "チャットで / と一緒に使うコマンドを作成しましょう。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "创建一个在聊天中通过 / 使用的命令。"}}}},
    "Contexto (%lld)": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Context (%lld)"}}, "es": {"stringUnit": {"state": "translated", "value": "Contexto (%lld)"}}, "fr": {"stringUnit": {"state": "translated", "value": "Contexte (%lld)"}}, "de": {"stringUnit": {"state": "translated", "value": "Kontext (%lld)"}}, "ja": {"stringUnit": {"state": "translated", "value": "参考情報 (%lld)"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "参考信息（%lld）"}}}},
    "Contexto de reuniões anteriores": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Previous meeting context"}}, "es": {"stringUnit": {"state": "translated", "value": "Contexto de reuniones anteriores"}}, "fr": {"stringUnit": {"state": "translated", "value": "Contexte des réunions précédentes"}}, "de": {"stringUnit": {"state": "translated", "value": "Kontext früherer Besprechungen"}}, "ja": {"stringUnit": {"state": "translated", "value": "過去の会議の参考情報"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "以往会议的背景信息"}}}},
    "Usar contexto": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Use context"}}, "es": {"stringUnit": {"state": "translated", "value": "Usar contexto"}}, "fr": {"stringUnit": {"state": "translated", "value": "Utiliser le contexte"}}, "de": {"stringUnit": {"state": "translated", "value": "Kontext verwenden"}}, "ja": {"stringUnit": {"state": "translated", "value": "参考情報を使用"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "使用参考信息"}}}},
    "Ver fala de origem": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "View source passage"}}, "es": {"stringUnit": {"state": "translated", "value": "Ver intervención de origen"}}, "fr": {"stringUnit": {"state": "translated", "value": "Voir le passage source"}}, "de": {"stringUnit": {"state": "translated", "value": "Ursprünglichen Beitrag anzeigen"}}, "ja": {"stringUnit": {"state": "translated", "value": "元の発言を表示"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "查看原始发言"}}}},
    "Parar gravação": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Stop recording"}}, "es": {"stringUnit": {"state": "translated", "value": "Detener grabación"}}, "fr": {"stringUnit": {"state": "translated", "value": "Arrêter l’enregistrement"}}, "de": {"stringUnit": {"state": "translated", "value": "Aufnahme stoppen"}}, "ja": {"stringUnit": {"state": "translated", "value": "録音を停止"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "停止录音"}}}},
    "Recolher assistente": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Collapse assistant"}}, "es": {"stringUnit": {"state": "translated", "value": "Contraer asistente"}}, "fr": {"stringUnit": {"state": "translated", "value": "Réduire l’assistant"}}, "de": {"stringUnit": {"state": "translated", "value": "Assistent einklappen"}}, "ja": {"stringUnit": {"state": "translated", "value": "アシスタントを折りたたむ"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "收起助手"}}}},
    "Painel": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Panel"}}, "es": {"stringUnit": {"state": "translated", "value": "Panel"}}, "fr": {"stringUnit": {"state": "translated", "value": "Panneau"}}, "de": {"stringUnit": {"state": "translated", "value": "Bereich"}}, "ja": {"stringUnit": {"state": "translated", "value": "パネル"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "面板"}}}},
    "Perguntar": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Ask"}}, "es": {"stringUnit": {"state": "translated", "value": "Preguntar"}}, "fr": {"stringUnit": {"state": "translated", "value": "Demander"}}, "de": {"stringUnit": {"state": "translated", "value": "Fragen"}}, "ja": {"stringUnit": {"state": "translated", "value": "質問"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "提问"}}}},
    "Transcrição após a reunião": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Transcript after the meeting"}}, "es": {"stringUnit": {"state": "translated", "value": "Transcripción después de la reunión"}}, "fr": {"stringUnit": {"state": "translated", "value": "Transcription après la réunion"}}, "de": {"stringUnit": {"state": "translated", "value": "Transkript nach der Besprechung"}}, "ja": {"stringUnit": {"state": "translated", "value": "会議後に文字起こし"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "会后转录"}}}},
    "Consulta": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Reference"}}, "es": {"stringUnit": {"state": "translated", "value": "Consulta"}}, "fr": {"stringUnit": {"state": "translated", "value": "Consultation"}}, "de": {"stringUnit": {"state": "translated", "value": "Ansicht"}}, "ja": {"stringUnit": {"state": "translated", "value": "参照"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "查阅"}}}},
    "Fechar painel": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Close panel"}}, "es": {"stringUnit": {"state": "translated", "value": "Cerrar panel"}}, "fr": {"stringUnit": {"state": "translated", "value": "Fermer le panneau"}}, "de": {"stringUnit": {"state": "translated", "value": "Bereich schließen"}}, "ja": {"stringUnit": {"state": "translated", "value": "パネルを閉じる"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "关闭面板"}}}},
    "Buscar na transcrição…": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Search transcript…"}}, "es": {"stringUnit": {"state": "translated", "value": "Buscar en la transcripción…"}}, "fr": {"stringUnit": {"state": "translated", "value": "Rechercher dans la transcription…"}}, "de": {"stringUnit": {"state": "translated", "value": "Transkript durchsuchen…"}}, "ja": {"stringUnit": {"state": "translated", "value": "文字起こしを検索…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "搜索转录…"}}}},
    "Pergunte sobre esta reunião.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Ask about this meeting."}}, "es": {"stringUnit": {"state": "translated", "value": "Pregunta sobre esta reunión."}}, "fr": {"stringUnit": {"state": "translated", "value": "Posez une question sur cette réunion."}}, "de": {"stringUnit": {"state": "translated", "value": "Stellen Sie Fragen zu dieser Besprechung."}}, "ja": {"stringUnit": {"state": "translated", "value": "この会議について質問してください。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "询问有关此次会议的问题。"}}}},
