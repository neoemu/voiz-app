    "Dúvidas e lacunas, sempre com a evidência que as sustenta.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doubts and gaps, always with the evidence that supports them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweifel und Lücken, stets mit den sie stützenden Belegen."
