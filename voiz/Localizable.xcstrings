            "state": "translated",
            "value": "Retrospective"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrospektive"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrospectiva"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétrospective"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "振り返り"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复盘"
          }
        }
      }
    },
    "Participei de uma retrospectiva de time. Registre o que funcionou, o que não funcionou e os experimentos combinados para o próximo ciclo.\nMantenha o foco em processo, não em culpa: descreva o problema e o efeito, não o culpado.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I attended a team retrospective. Capture what worked, what did not work and the experiments agreed for the next cycle.\nKeep the focus on process, not blame: describe the problem and its effect, not who is at fault."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe an einer Team-Retrospektive teilgenommen. Halte fest, was gut funktioniert hat, was nicht und welche Experimente für den nächsten Zyklus vereinbart wurden.\nKonzentriere dich auf den Prozess, nicht auf Schuld: Beschreibe das Problem und seine Auswirkungen, nicht die schuldige Person."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Participé en una retrospectiva del equipo. Registra qué funcionó, qué no funcionó y los experimentos acordados para el próximo ciclo.\nCéntrate en el proceso, no en la culpa: describe el problema y su efecto, no a quién culpar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’ai participé à une rétrospective d’équipe. Consignez ce qui a fonctionné, ce qui n’a pas fonctionné et les expérimentations convenues pour le prochain cycle.\nConcentrez-vous sur le processus, et non sur la faute : décrivez le problème et son effet, pas la personne à blâmer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チームの振り返りに参加しました。うまくいったこと、うまくいかなかったこと、次のサイクルに向けて合意した実験を記録してください。\n責任追及ではなくプロセスに焦点を当て、誰が悪いかではなく問題とその影響を説明してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我参加了团队复盘。请记录哪些方面有效、哪些方面无效，以及为下个周期商定的实验。\n聚焦流程而非追责：描述问题及其影响，不要指责个人。"
          }
        }
      }
    },
    "Como foi o ciclo e o clima da retro, em 3-5 frases.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
