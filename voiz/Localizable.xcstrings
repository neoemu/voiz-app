    "Quem ficou dono de cada frente, apenas conforme dito na call.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who owns each workstream, strictly as stated on the call."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer für welchen Arbeitsbereich verantwortlich ist, ausschließlich wie im Gespräch angegeben."
          }
        },
