          }
        }
      }
    },
    "A integração não vê esse destino. Abra a página ou database no Notion e compartilhe com a integração.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The integration can't see that destination. Open the page or database in Notion and share it with the integration."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Integration kann dieses Ziel nicht sehen. Öffne die Seite oder Datenbank in Notion und teile sie mit der Integration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La integración no puede ver ese destino. Abre la página o base de datos en Notion y compártela con la integración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’intégration ne peut pas accéder à cette destination. Ouvrez la page ou la base de données dans Notion et partagez-la avec l’intégration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連携からこの保存先を参照できません。Notion でページまたはデータベースを開き、連携と共有してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "集成无法访问该目标位置。请在 Notion 中打开页面或数据库，并与集成共享。"
          }
        }
      }
    },
