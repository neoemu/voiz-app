            "value": "决策者、预算、时间表、选择标准及提及的竞争对手。"
          }
        }
      }
    },
    "Ações para avançar o negócio, com responsável e data quando ditos.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Actions to move the deal forward, with owner and date when stated."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maßnahmen, um das Geschäft voranzubringen, mit verantwortlicher Person und Datum, sofern genannt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acciones para hacer avanzar la oportunidad, con responsable y fecha cuando se hayan indicado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actions pour faire progresser l’affaire, avec responsable et date lorsqu’ils ont été mentionnés."
          }
        },
        "ja": {
          "stringUnit": {
