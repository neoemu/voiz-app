    "1. Clique em 'Mostrar App' para revelar o app no Finder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Click 'Show app' to reveal the app in Finder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Klicke auf „App anzeigen“, um die App im Finder einzublenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Haz clic en «Mostrar app» para ver la app en Finder"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Cliquez sur « Afficher l’app » pour faire apparaître l’app dans le Finder"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1.「アプリを表示」をクリックして、Finder にアプリを表示します"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 点按“显示 App”，在 Finder 中显示该 App"
          }
        }
      }
    },
    "2. Clique em 'Abrir Ajustes' nas configurações de Acessibilidade": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Click 'Open Settings' in the Accessibility preferences"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Klicke in den Einstellungen für Bedienungshilfen auf „Einstellungen öffnen“"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Haz clic en «Abrir Ajustes» en las preferencias de Accesibilidad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Cliquez sur « Ouvrir les réglages » dans les préférences d’accessibilité"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2. アクセシビリティ設定で「設定を開く」をクリックします"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 在辅助功能设置中点按“打开设置”"
          }
        }
      }
    },
    "3. Clique no '+' e selecione o 'voiz.app' revelado no Finder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Click '+' and pick the 'voiz.app' revealed in Finder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Klicke auf „+“ und wähle die im Finder angezeigte „voiz.app“ aus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Haz clic en «+» y selecciona «voiz.app», que se muestra en Finder"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Cliquez sur « + » et sélectionnez « voiz.app », affichée dans le Finder"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3.「+」をクリックし、Finder に表示された「voiz.app」を選択します"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 点按“+”，然后选择 Finder 中显示的“voiz.app”"
          }
        }
      }
    },
    "4. Ative o switch ao lado do Voiz": {
      "extractionState": "manual",
      "localizations": {
        "en": {
