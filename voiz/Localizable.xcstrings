    "Se a Fn não responder, vá em Ajustes do Sistema → Teclado → \"Pressionar 🌐 para: Não fazer nada\".": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If Fn doesn't respond, go to System Settings → Keyboard → \"Press 🌐 key to: Do Nothing\"."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Fn nicht reagiert, gehe zu Systemeinstellungen → Tastatur → „🌐-Taste drücken für: Nichts tun“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si Fn no responde, ve a Ajustes del Sistema → Teclado → «Pulsar la tecla 🌐 para: No hacer nada»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si Fn ne répond pas, accédez à Réglages Système → Clavier → « Appuyer sur la touche 🌐 pour : Ne rien faire »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Fn が反応しない場合は、システム設定 → キーボード →「🌐キーを押して：何もしない」に移動してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
