    "Funciona só neste Mac, enquanto o Voiz está aberto. O token copiado sai da área de transferência após 60 segundos.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works only on this Mac while Voiz is open. A copied token is cleared from the clipboard after 60 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona solo en este Mac, mientras Voiz está abierto. El token copiado se borra del portapapeles a los 60 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne uniquement sur ce Mac, tant que Voiz est ouvert. Le jeton copié est effacé du presse-papiers après 60 secondes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert nur auf diesem Mac, solange Voiz geöffnet ist. Ein kopiertes Token wird nach 60 Sekunden aus der Zwischenablage entfernt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac で Voiz が開いている間だけ動作します。コピーしたトークンは 60 秒後にクリップボードから消去されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在此 Mac 上且 Voiz 打开时可用。复制的令牌会在 60 秒后从剪贴板清除。"
          }
        }
      }
    },
