    "Buscar uma nova versão do Voiz": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Check for a new version of Voiz"}}, "es": {"stringUnit": {"state": "translated", "value": "Buscar una nueva versión de Voiz"}}, "fr": {"stringUnit": {"state": "translated", "value": "Rechercher une nouvelle version de Voiz"}}, "de": {"stringUnit": {"state": "translated", "value": "Nach einer neuen Version von Voiz suchen"}}, "ja": {"stringUnit": {"state": "translated", "value": "Voizの新しいバージョンを確認"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "检查Voiz的新版本"}}}},
    "Este build recebe atualizações por instalação manual.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This build is updated by manual installation."}}, "es": {"stringUnit": {"state": "translated", "value": "Esta compilación se actualiza mediante instalación manual."}}, "fr": {"stringUnit": {"state": "translated", "value": "Cette version se met à jour par installation manuelle."}}, "de": {"stringUnit": {"state": "translated", "value": "Dieser Build wird durch manuelle Installation aktualisiert."}}, "ja": {"stringUnit": {"state": "translated", "value": "このビルドは手動インストールで更新します。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此构建版本通过手动安装更新。"}}}},
    "Conclua a gravação ou o processamento antes de atualizar.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Finish recording or processing before updating."}}, "es": {"stringUnit": {"state": "translated", "value": "Finaliza la grabación o el procesamiento antes de actualizar."}}, "fr": {"stringUnit": {"state": "translated", "value": "Terminez l’enregistrement ou le traitement avant la mise à jour."}}, "de": {"stringUnit": {"state": "translated", "value": "Beenden Sie die Aufnahme oder Verarbeitung vor dem Update."}}, "ja": {"stringUnit": {"state": "translated", "value": "更新する前に録音または処理を完了してください。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请先完成录制或处理再更新。"}}}},
    "Depois, clique novamente em Buscar atualizações para continuar.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Then click Check for Updates again to continue."}}, "es": {"stringUnit": {"state": "translated", "value": "Después, vuelve a hacer clic en Buscar actualizaciones para continuar."}}, "fr": {"stringUnit": {"state": "translated", "value": "Cliquez ensuite de nouveau sur Rechercher des mises à jour pour continuer."}}, "de": {"stringUnit": {"state": "translated", "value": "Klicken Sie danach erneut auf Nach Updates suchen, um fortzufahren."}}, "ja": {"stringUnit": {"state": "translated", "value": "その後、再度「アップデートを確認」をクリックして続行してください。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "然后再次点击“检查更新”以继续。"}}}},
