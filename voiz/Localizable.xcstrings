{
  "sourceLanguage": "pt-BR",
  "strings": {
    "Cancelar preparação": {"extractionState": "manual", "localizations": {"pt-BR": {"stringUnit": {"state": "translated", "value": "Cancelar preparação"}}, "en": {"stringUnit": {"state": "translated", "value": "Cancel preparation"}}, "es": {"stringUnit": {"state": "translated", "value": "Cancelar preparación"}}, "fr": {"stringUnit": {"state": "translated", "value": "Annuler la préparation"}}, "de": {"stringUnit": {"state": "translated", "value": "Vorbereitung abbrechen"}}, "ja": {"stringUnit": {"state": "translated", "value": "準備をキャンセル"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "取消准备"}}}},
    "Preparando detecção de fala…": {"extractionState": "manual", "localizations": {"pt-BR": {"stringUnit": {"state": "translated", "value": "Preparando detecção de fala…"}}, "en": {"stringUnit": {"state": "translated", "value": "Preparing speech detection…"}}, "es": {"stringUnit": {"state": "translated", "value": "Preparando detección de voz…"}}, "fr": {"stringUnit": {"state": "translated", "value": "Préparation de la détection de la parole…"}}, "de": {"stringUnit": {"state": "translated", "value": "Spracherkennung wird vorbereitet…"}}, "ja": {"stringUnit": {"state": "translated", "value": "音声検出を準備中…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在准备语音检测…"}}}},
    "Não foi possível preparar a detecção de fala. Confira a conexão para baixar o modelo e tente novamente.": {"extractionState": "manual", "localizations": {"pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível preparar a detecção de fala. Confira a conexão para baixar o modelo e tente novamente."}}, "en": {"stringUnit": {"state": "translated", "value": "Could not prepare speech detection. Check your connection to download the model and try again."}}, "es": {"stringUnit": {"state": "translated", "value": "No se pudo preparar la detección de voz. Comprueba la conexión para descargar el modelo e inténtalo de nuevo."}}, "fr": {"stringUnit": {"state": "translated", "value": "Impossible de préparer la détection de la parole. Vérifiez la connexion pour télécharger le modèle et réessayez."}}, "de": {"stringUnit": {"state": "translated", "value": "Die Spracherkennung konnte nicht vorbereitet werden. Prüfe die Verbindung zum Herunterladen des Modells und versuche es erneut."}}, "ja": {"stringUnit": {"state": "translated", "value": "音声検出を準備できませんでした。モデルをダウンロードできる接続を確認して、もう一度お試しください。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法准备语音检测。请检查网络连接以下载模型，然后重试。"}}}},
    "A gravação foi interrompida porque o áudio não pôde ser processado. O texto disponível foi preservado.": {"extractionState": "manual", "localizations": {"pt-BR": {"stringUnit": {"state": "translated", "value": "A gravação foi interrompida porque o áudio não pôde ser processado. O texto disponível foi preservado."}}, "en": {"stringUnit": {"state": "translated", "value": "Recording stopped because the audio could not be processed. Available text has been preserved."}}, "es": {"stringUnit": {"state": "translated", "value": "La grabación se detuvo porque no se pudo procesar el audio. Se conservó el texto disponible."}}, "fr": {"stringUnit": {"state": "translated", "value": "L’enregistrement a été interrompu car l’audio n’a pas pu être traité. Le texte disponible a été conservé."}}, "de": {"stringUnit": {"state": "translated", "value": "Die Aufnahme wurde beendet, weil das Audio nicht verarbeitet werden konnte. Der vorhandene Text wurde beibehalten."}}, "ja": {"stringUnit": {"state": "translated", "value": "音声を処理できなかったため録音を停止しました。取得済みのテキストは保持されています。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "由于无法处理音频，录制已停止。已有文本已保留。"}}}},
    "Não foi possível iniciar a gravação. Verifique o microfone e tente novamente.": {"extractionState": "manual", "localizations": {"pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível iniciar a gravação. Verifique o microfone e tente novamente."}}, "en": {"stringUnit": {"state": "translated", "value": "Could not start recording. Check your microphone and try again."}}, "es": {"stringUnit": {"state": "translated", "value": "No se pudo iniciar la grabación. Comprueba el micrófono e inténtalo de nuevo."}}, "fr": {"stringUnit": {"state": "translated", "value": "Impossible de démarrer l’enregistrement. Vérifiez le microphone et réessayez."}}, "de": {"stringUnit": {"state": "translated", "value": "Die Aufnahme konnte nicht gestartet werden. Prüfe das Mikrofon und versuche es erneut."}}, "ja": {"stringUnit": {"state": "translated", "value": "録音を開始できませんでした。マイクを確認して、もう一度お試しください。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法开始录制。请检查麦克风，然后重试。"}}}},
    "Não foi possível acessar as chaves de API. Tente novamente em Configurações → IA & Tradução.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Could not access API keys. Try again in Settings → AI & Translation."}}, "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível acessar as chaves de API. Tente novamente em Configurações → IA & Tradução."}}, "es": {"stringUnit": {"state": "translated", "value": "No se pudo acceder a las claves de API. Inténtalo de nuevo en Configuración → IA y traducción."}}, "fr": {"stringUnit": {"state": "translated", "value": "Impossible d’accéder aux clés API. Réessayez dans Réglages → IA et traduction."}}, "de": {"stringUnit": {"state": "translated", "value": "Auf die API-Schlüssel konnte nicht zugegriffen werden. Versuche es erneut unter Einstellungen → KI & Übersetzung."}}, "ja": {"stringUnit": {"state": "translated", "value": "APIキーにアクセスできませんでした。設定 → AIと翻訳で再試行してください。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法访问 API 密钥。请在设置 → AI 与翻译中重试。"}}}, "extractionState": "manual"},
    "Desativar neste Mac": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Deactivate on this Mac"}}, "es": {"stringUnit": {"state": "translated", "value": "Desactivar en este Mac"}}, "fr": {"stringUnit": {"state": "translated", "value": "Désactiver sur ce Mac"}}, "de": {"stringUnit": {"state": "translated", "value": "Auf diesem Mac deaktivieren"}}, "ja": {"stringUnit": {"state": "translated", "value": "このMacで無効にする"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "在此Mac上停用"}}}},
    "Vendas públicas ainda não abertas.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Public sales are not open yet."}}, "es": {"stringUnit": {"state": "translated", "value": "Las ventas al público aún no están abiertas."}}, "fr": {"stringUnit": {"state": "translated", "value": "Les ventes au public ne sont pas encore ouvertes."}}, "de": {"stringUnit": {"state": "translated", "value": "Der öffentliche Verkauf hat noch nicht begonnen."}}, "ja": {"stringUnit": {"state": "translated", "value": "一般販売はまだ開始していません。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "尚未开放公开销售。"}}}},
    "Em desenvolvimento": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "In development"}}, "es": {"stringUnit": {"state": "translated", "value": "En desarrollo"}}, "fr": {"stringUnit": {"state": "translated", "value": "En développement"}}, "de": {"stringUnit": {"state": "translated", "value": "In Entwicklung"}}, "ja": {"stringUnit": {"state": "translated", "value": "開発中"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "开发中"}}}},
    "Requer ativação": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Activation required"}}, "es": {"stringUnit": {"state": "translated", "value": "Requiere activación"}}, "fr": {"stringUnit": {"state": "translated", "value": "Activation requise"}}, "de": {"stringUnit": {"state": "translated", "value": "Aktivierung erforderlich"}}, "ja": {"stringUnit": {"state": "translated", "value": "有効化が必要"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "需要激活"}}}},
    "Reativar com esta chave": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Reactivate with this key"}}, "es": {"stringUnit": {"state": "translated", "value": "Reactivar con esta clave"}}, "fr": {"stringUnit": {"state": "translated", "value": "Réactiver avec cette clé"}}, "de": {"stringUnit": {"state": "translated", "value": "Mit diesem Schlüssel reaktivieren"}}, "ja": {"stringUnit": {"state": "translated", "value": "このキーで再有効化"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "使用此密钥重新激活"}}}},
    "Reativa esta instalação com a chave recuperada, sem apagar seu histórico.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Reactivate this installation using the recovered key, keeping your local history."}}, "es": {"stringUnit": {"state": "translated", "value": "Reactiva esta instalación con la clave recuperada sin borrar tu historial."}}, "fr": {"stringUnit": {"state": "translated", "value": "Réactive cette installation avec la clé récupérée sans supprimer votre historique."}}, "de": {"stringUnit": {"state": "translated", "value": "Reaktiviert diese Installation mit dem wiederhergestellten Schlüssel, ohne deinen Verlauf zu löschen."}}, "ja": {"stringUnit": {"state": "translated", "value": "履歴を削除せず、復元したキーでこのインストールを再有効化します。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "使用恢复的密钥重新激活此安装，保留本地历史记录。"}}}},
    "Abra o portal Dev para simular compras ou recuperar sua chave de teste por e-mail.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Open the Dev portal to simulate purchases or recover your test key by email."}}, "es": {"stringUnit": {"state": "translated", "value": "Abre el portal Dev para simular compras o recuperar tu clave de prueba por correo."}}, "fr": {"stringUnit": {"state": "translated", "value": "Ouvrez le portail Dev pour simuler des achats ou récupérer votre clé de test par e-mail."}}, "de": {"stringUnit": {"state": "translated", "value": "Öffne das Dev-Portal, um Käufe zu simulieren oder deinen Testschlüssel per E-Mail wiederherzustellen."}}, "ja": {"stringUnit": {"state": "translated", "value": "Dev ポータルを開いて購入をシミュレーションするか、テスト用キーをメールで復元します。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "打开 Dev 门户以模拟购买或通过电子邮件恢复测试密钥。"}}}},
    "Pagamento único. Sem vencimento ou renovação paga.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "One-time payment. No expiration or paid renewal."}}, "es": {"stringUnit": {"state": "translated", "value": "Pago único. Sin vencimiento ni renovación de pago."}}, "fr": {"stringUnit": {"state": "translated", "value": "Paiement unique. Sans expiration ni renouvellement payant."}}, "de": {"stringUnit": {"state": "translated", "value": "Einmalige Zahlung. Ohne Ablaufdatum oder kostenpflichtige Verlängerung."}}, "ja": {"stringUnit": {"state": "translated", "value": "お支払いは一度だけ。有効期限や有料の更新はありません。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "一次付费。永久有效，无需付费续期。"}}}},
    "Meu Mac": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "My Mac"}}, "es": {"stringUnit": {"state": "translated", "value": "Mi Mac"}}, "fr": {"stringUnit": {"state": "translated", "value": "Mon Mac"}}, "de": {"stringUnit": {"state": "translated", "value": "Mein Mac"}}, "ja": {"stringUnit": {"state": "translated", "value": "自分の Mac"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "我的 Mac"}}}},
    "Nome deste dispositivo": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This device’s name"}}, "es": {"stringUnit": {"state": "translated", "value": "Nombre de este dispositivo"}}, "fr": {"stringUnit": {"state": "translated", "value": "Nom de cet appareil"}}, "de": {"stringUnit": {"state": "translated", "value": "Name dieses Geräts"}}, "ja": {"stringUnit": {"state": "translated", "value": "このデバイスの名前"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此设备的名称"}}}},
    "Dispositivos": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Devices"}}, "es": {"stringUnit": {"state": "translated", "value": "Dispositivos"}}, "fr": {"stringUnit": {"state": "translated", "value": "Appareils"}}, "de": {"stringUnit": {"state": "translated", "value": "Geräte"}}, "ja": {"stringUnit": {"state": "translated", "value": "デバイス"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "设备"}}}},
    "%lld de %lld dispositivos ativos": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "%lld of %lld devices active"}}, "es": {"stringUnit": {"state": "translated", "value": "%lld de %lld dispositivos activos"}}, "fr": {"stringUnit": {"state": "translated", "value": "%lld appareils actifs sur %lld"}}, "de": {"stringUnit": {"state": "translated", "value": "%lld von %lld Geräten aktiv"}}, "ja": {"stringUnit": {"state": "translated", "value": "%lld / %lld 台のデバイスが有効"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已激活 %lld 台设备，共可激活 %lld 台"}}}},
    "Revogar este dispositivo?": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Revoke this device?"}}, "es": {"stringUnit": {"state": "translated", "value": "¿Revocar este dispositivo?"}}, "fr": {"stringUnit": {"state": "translated", "value": "Révoquer cet appareil ?"}}, "de": {"stringUnit": {"state": "translated", "value": "Dieses Gerät widerrufen?"}}, "ja": {"stringUnit": {"state": "translated", "value": "このデバイスの認証を取り消しますか？"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "撤销此设备的授权？"}}}},
    "Verificação necessária": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Verification required"}}, "es": {"stringUnit": {"state": "translated", "value": "Verificación necesaria"}}, "fr": {"stringUnit": {"state": "translated", "value": "Vérification nécessaire"}}, "de": {"stringUnit": {"state": "translated", "value": "Überprüfung erforderlich"}}, "ja": {"stringUnit": {"state": "translated", "value": "認証が必要です"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "需要验证"}}}},
    "Licenciamento indisponível neste build": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Licensing unavailable in this build"}}, "es": {"stringUnit": {"state": "translated", "value": "Licencias no disponibles en esta compilación"}}, "fr": {"stringUnit": {"state": "translated", "value": "Licences indisponibles dans cette version"}}, "de": {"stringUnit": {"state": "translated", "value": "Lizenzierung in diesem Build nicht verfügbar"}}, "ja": {"stringUnit": {"state": "translated", "value": "このビルドではライセンス認証を利用できません"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此构建版本不支持许可证激活"}}}},
    "Verificar novamente": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Verify again"}}, "es": {"stringUnit": {"state": "translated", "value": "Verificar de nuevo"}}, "fr": {"stringUnit": {"state": "translated", "value": "Vérifier à nouveau"}}, "de": {"stringUnit": {"state": "translated", "value": "Erneut überprüfen"}}, "ja": {"stringUnit": {"state": "translated", "value": "再認証"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "重新验证"}}}},
    "Este Mac": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This Mac"}}, "es": {"stringUnit": {"state": "translated", "value": "Este Mac"}}, "fr": {"stringUnit": {"state": "translated", "value": "Ce Mac"}}, "de": {"stringUnit": {"state": "translated", "value": "Dieser Mac"}}, "ja": {"stringUnit": {"state": "translated", "value": "この Mac"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此 Mac"}}}},
    "Este Mac foi revogado. Use Reativar este Mac se quiser ativá-lo novamente.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This Mac was revoked. Use Reactivate this Mac if you want to activate it again."}}, "es": {"stringUnit": {"state": "translated", "value": "Este Mac fue revocado. Usa Reactivar este Mac si quieres activarlo de nuevo."}}, "fr": {"stringUnit": {"state": "translated", "value": "Ce Mac a été révoqué. Choisissez Réactiver ce Mac pour l’activer à nouveau."}}, "de": {"stringUnit": {"state": "translated", "value": "Dieser Mac wurde widerrufen. Wähle Diesen Mac erneut aktivieren, wenn du ihn wieder aktivieren möchtest."}}, "ja": {"stringUnit": {"state": "translated", "value": "この Mac の認証は取り消されています。再度使用するには「この Mac を再認証」を選択してください。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此 Mac 的授权已被撤销。如需重新激活，请使用“重新激活此 Mac”。"}}}},
    "Voiz Dev está em uso.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Voiz Dev is in use."}}, "es": {"stringUnit": {"state": "translated", "value": "Voiz Dev está en uso."}}, "fr": {"stringUnit": {"state": "translated", "value": "Voiz Dev est en cours d’utilisation."}}, "de": {"stringUnit": {"state": "translated", "value": "Voiz Dev wird gerade verwendet."}}, "ja": {"stringUnit": {"state": "translated", "value": "Voiz Dev は使用中です。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "Voiz Dev 正在使用中。"}}}},
    "Conclua a gravação, o processamento ou a resposta de IA antes de encerrar.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Finish recording, processing, or the AI response before quitting."}}, "es": {"stringUnit": {"state": "translated", "value": "Finaliza la grabación, el procesamiento o la respuesta de IA antes de salir."}}, "fr": {"stringUnit": {"state": "translated", "value": "Terminez l’enregistrement, le traitement ou la réponse de l’IA avant de quitter."}}, "de": {"stringUnit": {"state": "translated", "value": "Beenden Sie die Aufnahme, die Verarbeitung oder die KI-Antwort, bevor Sie die App schließen."}}, "ja": {"stringUnit": {"state": "translated", "value": "終了する前に、録音、処理、または AI の回答を完了してください。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请先完成录音、处理或 AI 回复，再退出。"}}}},
    "O nome contém caracteres inválidos.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The name contains invalid characters."}}, "es": {"stringUnit": {"state": "translated", "value": "El nombre contiene caracteres no válidos."}}, "fr": {"stringUnit": {"state": "translated", "value": "Le nom contient des caractères non valides."}}, "de": {"stringUnit": {"state": "translated", "value": "Der Name enthält ungültige Zeichen."}}, "ja": {"stringUnit": {"state": "translated", "value": "名前に無効な文字が含まれています。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "姓名中包含无效字符。"}}}},
    "Bem-vindo ao Voiz": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Welcome to Voiz"}}, "es": {"stringUnit": {"state": "translated", "value": "Te damos la bienvenida a Voiz"}}, "fr": {"stringUnit": {"state": "translated", "value": "Bienvenue dans Voiz"}}, "de": {"stringUnit": {"state": "translated", "value": "Willkommen bei Voiz"}}, "ja": {"stringUnit": {"state": "translated", "value": "Voiz へようこそ"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "欢迎使用 Voiz"}}}},
    "Local por escolha": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Local by choice"}}, "es": {"stringUnit": {"state": "translated", "value": "Local, por elección"}}, "fr": {"stringUnit": {"state": "translated", "value": "Le local, par choix"}}, "de": {"stringUnit": {"state": "translated", "value": "Bewusst lokal"}}, "ja": {"stringUnit": {"state": "translated", "value": "ローカルという選択"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "选择本地使用"}}}},
    "Oi %@, pergunte o que quiser": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Hi %@, ask anything"}}, "es": {"stringUnit": {"state": "translated", "value": "Hola %@, pregunta lo que quieras"}}, "fr": {"stringUnit": {"state": "translated", "value": "Bonjour %@, posez votre question"}}, "de": {"stringUnit": {"state": "translated", "value": "Hallo %@, frag, was du möchtest"}}, "ja": {"stringUnit": {"state": "translated", "value": "%@ さん、何でも聞いてください"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "你好，%@，想问什么都可以"}}}},
    "Disponível": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Available"}}, "es": {"stringUnit": {"state": "translated", "value": "Disponible"}}, "fr": {"stringUnit": {"state": "translated", "value": "Disponible"}}, "de": {"stringUnit": {"state": "translated", "value": "Verfügbar"}}, "ja": {"stringUnit": {"state": "translated", "value": "利用可能"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已推出"}}}},
    "Perfil": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Profile"}}, "es": {"stringUnit": {"state": "translated", "value": "Perfil"}}, "fr": {"stringUnit": {"state": "translated", "value": "Profil"}}, "de": {"stringUnit": {"state": "translated", "value": "Profil"}}, "ja": {"stringUnit": {"state": "translated", "value": "プロフィール"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "个人资料"}}}},
    "Voltar": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Back"}}, "es": {"stringUnit": {"state": "translated", "value": "Atrás"}}, "fr": {"stringUnit": {"state": "translated", "value": "Retour"}}, "de": {"stringUnit": {"state": "translated", "value": "Zurück"}}, "ja": {"stringUnit": {"state": "translated", "value": "戻る"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "返回"}}}},
    "Como podemos chamar você?": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "What should we call you?"}}, "es": {"stringUnit": {"state": "translated", "value": "¿Cómo podemos llamarte?"}}, "fr": {"stringUnit": {"state": "translated", "value": "Comment vous appelez-vous ?"}}, "de": {"stringUnit": {"state": "translated", "value": "Wie dürfen wir dich nennen?"}}, "ja": {"stringUnit": {"state": "translated", "value": "どのようにお呼びすればよいですか？"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "我们该如何称呼你？"}}}},
    "Da conversa à próxima ideia.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "From conversation to your next idea."}}, "es": {"stringUnit": {"state": "translated", "value": "De la conversación a tu próxima idea."}}, "fr": {"stringUnit": {"state": "translated", "value": "De la conversation à votre prochaine idée."}}, "de": {"stringUnit": {"state": "translated", "value": "Vom Gespräch zur nächsten Idee."}}, "ja": {"stringUnit": {"state": "translated", "value": "会話から、次のアイデアへ。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "从对话，走向下一个灵感。"}}}},
    "Seu trabalho, no seu Mac.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Your work, on your Mac."}}, "es": {"stringUnit": {"state": "translated", "value": "Tu trabajo, en tu Mac."}}, "fr": {"stringUnit": {"state": "translated", "value": "Votre travail, sur votre Mac."}}, "de": {"stringUnit": {"state": "translated", "value": "Deine Arbeit, auf deinem Mac."}}, "ja": {"stringUnit": {"state": "translated", "value": "あなたの作業を、あなたの Mac で。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "你的工作，保存在你的 Mac 上。"}}}},
    "Seus dados e gravações neste Mac, com todas as funcionalidades locais. Você escolhe o provedor para os recursos de IA.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Your data and recordings on this Mac, with all local features. You choose the provider for AI features."}}, "es": {"stringUnit": {"state": "translated", "value": "Tus datos y grabaciones en este Mac, con todas las funciones locales. Tú eliges el proveedor para las funciones de IA."}}, "fr": {"stringUnit": {"state": "translated", "value": "Vos données et enregistrements sur ce Mac, avec toutes les fonctions locales. Vous choisissez le fournisseur pour les fonctions d’IA."}}, "de": {"stringUnit": {"state": "translated", "value": "Deine Daten und Aufnahmen auf diesem Mac, mit allen lokalen Funktionen. Den Anbieter für KI-Funktionen wählst du selbst."}}, "ja": {"stringUnit": {"state": "translated", "value": "データと録音をこの Mac に保存し、すべてのローカル機能を利用できます。AI 機能のプロバイダーは自分で選べます。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "数据和录音保存在这台 Mac 上，可使用全部本地功能。AI 功能的服务商由你选择。"}}}},
    "Conheça seu Voiz": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Get to know Voiz"}}, "es": {"stringUnit": {"state": "translated", "value": "Conoce tu Voiz"}}, "fr": {"stringUnit": {"state": "translated", "value": "Découvrez Voiz"}}, "de": {"stringUnit": {"state": "translated", "value": "Lerne Voiz kennen"}}, "ja": {"stringUnit": {"state": "translated", "value": "Voiz を知る"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "了解你的 Voiz"}}}},
    "Use até 80 caracteres no nome.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Use up to 80 characters for your name."}}, "es": {"stringUnit": {"state": "translated", "value": "Usa un máximo de 80 caracteres para el nombre."}}, "fr": {"stringUnit": {"state": "translated", "value": "Utilisez au maximum 80 caractères pour votre nom."}}, "de": {"stringUnit": {"state": "translated", "value": "Verwende höchstens 80 Zeichen für deinen Namen."}}, "ja": {"stringUnit": {"state": "translated", "value": "名前は 80 文字以内で入力してください。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "姓名最多可包含 80 个字符。"}}}},
    "Olá, %@": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Hello, %@"}}, "es": {"stringUnit": {"state": "translated", "value": "Hola, %@"}}, "fr": {"stringUnit": {"state": "translated", "value": "Bonjour, %@"}}, "de": {"stringUnit": {"state": "translated", "value": "Hallo, %@"}}, "ja": {"stringUnit": {"state": "translated", "value": "こんにちは、%@ さん"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "你好，%@"}}}},
