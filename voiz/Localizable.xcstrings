    "Sugere gravar quando há reunião agendada. Lê o calendário local do Mac — nada sai do seu Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggests recording when a meeting is scheduled. Reads the local Mac calendar — nothing leaves your Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlägt eine Aufnahme vor, wenn eine Besprechung geplant ist. Liest den lokalen Mac-Kalender — nichts verlässt deinen Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugiere grabar cuando hay una reunión programada. Lee el calendario local del Mac; nada sale de tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggère un enregistrement lorsqu’une réunion est planifiée. Lit le calendrier local du Mac — rien ne quitte votre Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定されたミーティングがあると録音を提案します。Mac のローカルカレンダーを読み取りますが、データが Mac の外に出ることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有已安排的会议时建议录制。只读取 Mac 本地日历，任何数据都不会离开你的 Mac。"
          }
        }
      }
    },
