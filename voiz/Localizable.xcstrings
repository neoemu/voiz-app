    "Token do Notion inválido. Gere um Internal Integration Token novo em notion.so/my-integrations.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid Notion token. Create a new Internal Integration Token at notion.so/my-integrations."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültiges Notion-Token. Erstelle unter notion.so/my-integrations ein neues Internal Integration Token."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El token de Notion no es válido. Crea un Internal Integration Token nuevo en notion.so/my-integrations."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeton Notion non valide. Créez un nouvel Internal Integration Token sur notion.so/my-integrations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
