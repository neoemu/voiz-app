    "Prévia rápida com Whisper Small durante a gravação. O modelo escolhido gera o transcript final depois que você encerra.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast preview with Whisper Small during recording. The selected model creates the final transcript after you stop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnelle Vorschau mit Whisper Small während der Aufnahme. Das ausgewählte Modell erstellt das endgültige Transkript, nachdem du stoppst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa rápida con Whisper Small durante la grabación. El modelo seleccionado genera la transcripción final después de detenerla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu rapide avec Whisper Small pendant l’enregistrement. Le modèle sélectionné crée la transcription finale après l’arrêt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音中は Whisper Small で素早くプレビューします。停止後、選択したモデルで最終版の文字起こしを生成します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制期间使用 Whisper Small 快速预览。停止后，所选模型会生成最终转录文本。"
          }
        }
      }
    },
