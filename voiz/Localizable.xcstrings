    "Este motor não aplicou o vocabulário personalizado. Use WhisperKit para aplicar os termos.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This engine did not apply the custom vocabulary. Use WhisperKit to apply the terms."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Engine hat das eigene Vokabular nicht angewendet. Verwenden Sie WhisperKit, um die Begriffe anzuwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este motor no aplicó el vocabulario personalizado. Usa WhisperKit para aplicar los términos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce moteur n’a pas appliqué le vocabulaire personnalisé. Utilisez WhisperKit pour appliquer les termes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエンジンはカスタム語彙を適用しませんでした。語句を適用するにはWhisperKitを使用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此引擎未应用自定义词汇。请使用WhisperKit应用词条。"
          }
        }
      }
    },
    "Falha na transcrição. Você pode tentar novamente pelo histórico.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription failed. You can try again from history."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkription fehlgeschlagen. Sie können es im Verlauf erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción falló. Puedes intentarlo de nuevo desde el historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la transcription. Vous pouvez réessayer depuis l’historique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしに失敗しました。履歴から再試行できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转写失败。可从历史记录中重试。"
          }
        }
      }
    },
