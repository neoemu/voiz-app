    "Não foi possível abrir o áudio. O texto anterior foi mantido.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio could not be opened. The previous text was kept."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme konnte nicht geöffnet werden. Der vorherige Text wurde beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir el audio. Se conservó el texto anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir l’audio. Le texte précédent a été conservé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声を開けませんでした。前のテキストは保持されています。"
          }
        },
