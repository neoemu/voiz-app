    "Gravação com pós-processamento completo (ASR em lotes, diarização, eco e resumo automático).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio recording with full post-processing in background (batch ASR, diarization, echo and summary)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audioaufnahme mit vollständiger Nachbearbeitung im Hintergrund (Batch-ASR, Sprechertrennung, Echobeseitigung und automatische Zusammenfassung)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabación de audio con posprocesamiento completo en segundo plano (ASR por lotes, diarización, eco y resumen automático)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement audio avec post-traitement complet en arrière-plan (ASR par lots, diarisation, écho et résumé automatique)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドで完全な後処理を行う音声録音（バッチ ASR、話者分離、エコー除去、自動要約）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在后台进行完整后处理的音频录制（批量 ASR、说话人分离、回声消除和自动摘要）。"
          }
        }
      }
    },
    "Transcrição ao vivo leve por streaming, pronta ao encerrar. Resumo e diarização sob demanda.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightweight streaming live transcription, ready when stopped. Summary and diarization on demand."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ressourcenschonende Live-Transkription per Streaming, beim Stoppen sofort fertig. Zusammenfassung und Sprechertrennung bei Bedarf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcripción ligera en directo por streaming, lista al detenerse. Resumen y diarización bajo demanda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription légère en direct par streaming, prête dès l’arrêt. Résumé et diarisation à la demande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軽量なストリーミングによるライブ文字起こし。停止時には完成しています。要約と話者分離は必要に応じて実行します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻量级流式实时转录，停止时即可完成。按需生成摘要和进行说话人分离。"
          }
        }
      }
    },
