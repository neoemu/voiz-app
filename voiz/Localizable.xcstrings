    "A porta local %lld já está em uso. Feche o outro serviço e tente novamente.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local port %lld is already in use. Close the other service and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der lokale Port %lld wird bereits verwendet. Beende den anderen Dienst und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puerto local %lld ya está en uso. Cierra el otro servicio y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le port local %lld est déjà utilisé. Fermez l’autre service et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルポート %lld はすでに使用中です。他のサービスを終了して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地端口 %lld 已被占用。请关闭其他服务后重试。"
          }
        }
      }
    },
