    "Digite seu nome para continuar.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Enter your name to continue."}}, "es": {"stringUnit": {"state": "translated", "value": "Introduce tu nombre para continuar."}}, "fr": {"stringUnit": {"state": "translated", "value": "Saisissez votre nom pour continuer."}}, "de": {"stringUnit": {"state": "translated", "value": "Gib deinen Namen ein, um fortzufahren."}}, "ja": {"stringUnit": {"state": "translated", "value": "続けるには名前を入力してください。"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请输入你的姓名以继续。"}}}},
