    "A cópia na nuvem será removida em %@. Baixe ou exporte seus textos antes disso.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cloud copy will be removed on %@. Download or export your texts before then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia en la nube se eliminará el %@. Descarga o exporta tus textos antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie dans le cloud sera supprimée le %@. Téléchargez ou exportez vos textes d’ici là."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopie in der Cloud wird am %@ entfernt. Lade deine Texte vorher herunter oder exportiere sie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウド上のコピーは %@ に削除されます。それまでにテキストをダウンロードまたは書き出してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端副本将于 %@ 移除。请在此之前下载或导出你的文本。"
          }
        }
      }
    },
