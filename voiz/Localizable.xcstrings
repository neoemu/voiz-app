        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dudas y carencias, siempre con las pruebas que las sustentan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doutes et lacunes, toujours accompagnés des éléments qui les étayent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
