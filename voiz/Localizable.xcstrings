    "Aviso de consumo: a prévia contínua a cada 1s com Whisper consome mais CPU e bateria (~17%). Desnecessária no modo Granola.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Energy warning: continuous 1s Whisper preview uses more CPU and battery (~17%). Not needed in Granola mode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Energiehinweis: Die kontinuierliche Whisper-Vorschau im 1-Sekunden-Takt benötigt mehr CPU und Akku (~17 %). Im Granola-Modus nicht erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso de consumo: la vista previa continua de Whisper cada 1 s usa más CPU y batería (~17 %). No es necesaria en el modo Granola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avertissement énergétique : l’aperçu continu Whisper toutes les 1 s sollicite davantage le processeur et la batterie (~17 %). Inutile en mode Granola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "消費電力に関する注意：Whisper の連続プレビューを1秒ごとに行うと、CPU とバッテリーの消費が増えます（約17%）。Granola モードでは不要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能耗提示：每 1 秒运行一次 Whisper 连续预览会占用更多 CPU 并消耗更多电量（约 17%）。Granola 模式下无需启用。"
          }
        }
      }
    },
